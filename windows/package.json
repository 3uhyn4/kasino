{
  "name": "kasino",
  "productName": "Kasino",
  "version": "1.0.0",
  "description": "Casino game practice & odds trainer — no real money",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "io.github.kasino",
    "productName": "Kasino",
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "assets/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "artifactName": "Kasino-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Kasino-${version}-portable.exe"
    }
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  }
}
